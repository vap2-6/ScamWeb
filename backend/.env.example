# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Get a free key at https://console.cloud.google.com/apis/library/safebrowsing.googleapis.com
SAFE_BROWSING_API_KEY=

PORT=3001

# Feature flags
ENABLE_LIVE_SCRAPING=true
ENABLE_WHOIS=true

# Optional: WHOISXML API Key (falls back to free ICANN RDAP if omitted)
WHOISXML_API_KEY=

# Optional: Instagram session cookie for private/restricted post scraping
INSTAGRAM_SESSION_ID=
